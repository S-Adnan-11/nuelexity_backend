    "cors": "2.8.6",
    "express": "5.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "typescript": "5.9.3",
    "@electric-sql/pglite": "0.3.14"
  }
}
