{
  "name": "nuelexity-backend",
  "type": "module",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10.9.0 <13"
  },
  "scripts": {
    "dev": "node --import ./scripts/env.mjs --import tsx --watch index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./scripts/production-env.mjs dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "env:init": "node scripts/init-env.mjs",
    "config:check": "node --import ./scripts/env.mjs --import tsx scripts/check-config.ts",
    "db:inspect": "node --import ./scripts/env.mjs --import tsx scripts/inspect-database.ts",
    "db:inspect-api": "node --import ./scripts/env.mjs --import tsx scripts/inspect-api.ts",
    "schema:check": "node --import ./scripts/env.mjs --import tsx scripts/check-model-schema.ts",
    "models:check": "node --import ./scripts/env.mjs --import tsx scripts/check-model-generation.ts",
    "test:startup": "node scripts/check-startup.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "smoke:deployed": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "typescript": "5.9.3",
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "vitest": "4.1.12",
    "vite": "7.3.7"
  },
  "allowScripts": {
    "esbuild": true
  }
}
