{
  "name": "nuelexity-backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch index.ts",
    "start": "bun index.ts",
