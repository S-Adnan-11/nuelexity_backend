# Server-only settings. Never put these in a frontend .env.
PORT=3002
FRONTEND_ORIGINS=http://localhost:3000
# Leave at 0 locally. Configure only for a known reverse proxy with a fixed hop count.
TRUST_PROXY_HOPS=0
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
TAVILY_API_KEY=
# Generate once: bun -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
# Keep stable across restarts and all backend instances.
GUEST_ID_SECRET=

# No paid gateway. "none" returns real search excerpts; "groq" synthesizes answers.
AI_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GUEST_DAILY_LIMIT=2
USER_DAILY_LIMIT=5
IP_DAILY_LIMIT=10
GLOBAL_DAILY_LIMIT=25
GLOBAL_MONTHLY_LIMIT=800
GLOBAL_MINUTE_LIMIT=4
REQUEST_TIMEOUT_MS=60000
# Required for guest search in production; set matching public frontend site key.
TURNSTILE_SECRET_KEY=

# Optional, used only by read-only metadata inspection. Runtime uses Data API.
DIRECT_URL=
DATABASE_URL=
